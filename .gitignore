# deps
node_modules/

# local env
*.local

# aider
.aider*

# eslint cache
.eslintcache

# build output
dist/

# Claude Code local working state (worktrees, session notes, local settings).
# Never tracked; gitignoring it also keeps worker_implement(worktree:true)'s
# untracked-file copy from descending into agent worktrees (which can hold
# live sockets -> ENOTSUP on copyfile).
.claude/
# gate-b fixture server writes this at runtime (live ports) — never commit
tests/fixtures/browser/manifest.runtime.json
.claude-attachments/

# Pi + plan-mode local working state (session todos, approved plans, per-repo
# context snapshots). Machine-local scratch, and a tracked plan would go stale
# against the code it describes.
.pi/
.github-router/
