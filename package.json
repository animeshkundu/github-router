{
  "name": "@animeshkundu/github-router",
  "version": "0.3.269",
  "license": "MIT",
  "description": "A reverse proxy that exposes GitHub Copilot as OpenAI and Anthropic compatible API endpoints.",
  "keywords": [
    "proxy",
    "github-copilot",
    "openai-compatible",
    "anthropic-compatible",
    "claude-code",
    "codex",
    "reverse-proxy",
    "copilot"
  ],
  "homepage": "https://github.com/animeshkundu/github-router",
  "bugs": "https://github.com/animeshkundu/github-router/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animeshkundu/github-router.git"
  },
  "author": "animeshkundu",
  "type": "module",
  "bin": {
    "github-router": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && bun scripts/copy-browser-ext.ts",
    "dev": "bun run --watch ./src/main.ts",
    "discover:fields": "bash scripts/discover-new-fields.sh",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint --cache .",
    "prepack": "bun run build",
    "prepare": "(simple-git-hooks || true)",
    "probe:copilot": "bash scripts/probe-copilot-compat.sh --strict",
    "verify:lockfile": "node scripts/verify-lockfile-provenance.mjs",
    "smoke:workers": "bun scripts/smoke-workers.ts",
    "release": "./publish/release.sh",
    "start": "NODE_ENV=production bun run ./src/main.ts",
    "test": "bun run build && bun scripts/run-tests.ts",
    "typecheck": "tsc && tsc -p tsconfig.browser.json",
    "verify:serve": "node scripts/verify-serve-session.mjs",
    "verify:plan-mode": "node scripts/verify-plan-mode-cloudcli.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "trustedDependencies": [
    "@vscode/ripgrep"
  ],
  "lint-staged": {
    "*": "bun run lint --fix"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "citty": "^0.2.2",
    "clipboardy": "^5.3.2",
    "consola": "^3.4.2",
    "diff": "9.0.0",
    "fetch-event-stream": "^0.1.6",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.33",
    "ignore": "7.0.6",
    "marked": "^18.0.7",
    "partial-json": "0.1.7",
    "proxy-from-env": "^2.1.0",
    "srvx": "^0.12.5",
    "tree-sitter-wasms": "^0.1.13",
    "typebox": "1.3.9",
    "undici": "^8.9.0",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.21.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/proxy-from-env": "^1.0.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
